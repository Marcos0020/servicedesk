# ============================================================
# Service Desk — Environment Variables (.env)
# Copy to .env and fill in your values. Never commit .env!
# ============================================================

# ── Application ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# ── JWT Authentication ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=8h

# ── Oracle Database (Oracle Cloud) ──────────────────────────
ORACLE_USER=servicedesk_user
ORACLE_PASSWORD=YourStrongPassword123!
# Autonomous DB connection string (from Oracle Cloud wallet)
ORACLE_CONNECTION_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=your_service_name_high))(security=(ssl_server_dn_match=yes)))
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# ── Gmail IMAP ───────────────────────────────────────────────
# Use an App Password (not your real password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=suporte@suaempresa.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Email Fetch Scheduler ────────────────────────────────────
# How often to poll Gmail (minutes)
EMAIL_CHECK_INTERVAL_MINUTES=5

# ── File Storage ─────────────────────────────────────────────
# Absolute or relative path where uploaded files are saved
STORAGE_PATH=./storage

# ── Backup ───────────────────────────────────────────────────
BACKUP_PATH=./backups
# Cron expression: default = daily at 02:00 AM
BACKUP_CRON=0 2 * * *
